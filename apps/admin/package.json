{
  "name": "@kumodana/admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "typecheck": "cf workers types && tsc -p .",
    "test": "vitest run",
