  },
  "dependencies": {
    "@kumodana/shared": "0.0.0",
    "hono": "4.13.13",
    "jose": "6.2.12",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-52b0dc0e9",
    "@cloudflare/vitest-plugin": "1.4.0",
    "cf": "1.0.0-beta.13",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
